{
  "name": "@kitoca/order-engine",
  "version": "1.0.0",
  "description": "TypeScript library for building processing and checkout pipelines for unconventional pets, featuring stock validation, species-based discounts, and post-sale events, with no dependencies on APIs or HTTP",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "checkout",
    "order-pipeline",
    "e-commerce",
    "design-patterns",
    "exotic-pets",
    "typescript"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "demo": "tsc && node dist/demo.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  }
}
